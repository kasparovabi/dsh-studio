<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.kasparov.dsh-tailnet-proxy</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/env</string>
		<string>node</string>
		<string>REPLACE_WITH_CHECKOUT_PATH/scripts/tailnet-proxy.js</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>15</integer>
	<!-- The log names every peer that connects, so it belongs in the user's own
	     Logs directory rather than in the world-readable temp directory. -->
	<key>StandardOutPath</key>
	<string>REPLACE_WITH_HOME/Library/Logs/dsh-tailnet-proxy.log</string>
	<key>StandardErrorPath</key>
	<string>REPLACE_WITH_HOME/Library/Logs/dsh-tailnet-proxy.log</string>
</dict>
</plist>
